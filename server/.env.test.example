# Test environment — copy to .env.test (gitignored) and fill in.
#
# CRITICAL: DATABASE_URL must point to a SEPARATE database from your dev DB.
# The test setup runs deleteMany() on every Brand, Product, Membership, etc.
# row in this database after every test.
#
# Two safe options:
#
#   1) Local Postgres via Docker (recommended for local dev):
#        docker run -d --name rekaman-test-db -p 5433:5432 \
#          -e POSTGRES_PASSWORD=test postgres:17
#        DATABASE_URL='postgresql://postgres:test@localhost:5433/postgres'
#
#   2) Neon test branch (no Docker required):
#        Create a branch in the Neon dashboard, copy its connection URL here.
#        Then also set RUN_DESTRUCTIVE_TESTS=true so the safety check passes.

DATABASE_URL='postgresql://postgres:test@localhost:5433/postgres'

# Set to 'true' ONLY if DATABASE_URL is a non-localhost test database
# (e.g. a Neon test branch). Setup will refuse to run otherwise.
RUN_DESTRUCTIVE_TESTS=

# Required by env validation. Any 32+ char string is fine for tests.
JWT_SECRET='test-secret-must-be-at-least-32-characters-long-for-validation'
JWT_EXPIRY='7d'

NODE_ENV=test
LOG_LEVEL=error
SERVICE_NAME=api-test
