# === REQUIRED ===
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database (from Neon)
DATABASE_URL="postgresql://..."

# Auth
JWT_SECRET="generate-with-openssl-rand-base64-32"
JWT_EXPIRY="7d"
COOKIE_DOMAIN=""

# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/auth/google/callback"

# Sentry
SENTRY_DSN=""

# Frontend URL (for OAuth redirect after login)
DASHBOARD_URL="http://localhost:5173"

# Service identity (for logging/tracing)
SERVICE_NAME="api"

# === GENERATION PIPELINE (Week 5+) ===
# Meshy.ai (photos → 3D)
MESHY_API_KEY=""
MESHY_API_BASE="https://api.meshy.ai"
MESHY_WEBHOOK_SECRET=""

# Upstash Redis (BullMQ queue + future rate limiting)
REDIS_URL=""

# AWS — products bucket (Meshy GLB destination)
# IAM user: rekaman-server (server-side only — never use root)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
S3_REGION="ap-south-1"
AWS_S3_BUCKET_PRODUCTS=""
S3_BUCKET_NAME=""  # legacy, kept for compat

# Worker tuning (override only if needed)
GENERATION_POLL_INTERVAL_MS=5000
GENERATION_MAX_DURATION_MS=300000
GENERATION_MAX_RETRIES=3

# === LATER PHASES ===
# Razorpay (Week 10)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Resend (Week 8 — transactional email)
RESEND_API_KEY=""
